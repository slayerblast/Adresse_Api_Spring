<!--
  Plugin fragment to paste into a Maven project's <build><plugins> to get the
  same L0 (Spotless autofix) + L1 (Checkstyle) + L1/L2 (PMD/CPD) + coverage
  (JaCoCo) quality gate as MIGRATION_BATCH/scripts/analysis/java.

  Copy checkstyle.cool.xml or checkstyle.strict.xml to the project root as
  "checkstyle.xml", and pmd-ruleset.cool.xml or pmd-ruleset.strict.xml as
  "pmd-ruleset.xml". See README.md in this folder for the cool/strict switches.
-->
<plugins>
    <plugin>
        <!-- L0 autofix: strips unused/unordered imports and trailing whitespace before PMD ever runs -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
            <java>
                <googleJavaFormat>
                    <version>1.36.1</version>
                </googleJavaFormat>
                <removeUnusedImports/>
                <importOrder/>
                <trimTrailingWhitespace/>
                <endWithNewline/>
            </java>
        </configuration>
        <executions>
            <execution>
                <id>spotless-apply</id>
                <phase>process-sources</phase>
                <goals>
                    <goal>apply</goal>
                </goals>
            </execution>
        </executions>
    </plugin>
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <configuration>
            <rulesets>
                <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
            </rulesets>
            <sourceDirectory>${project.basedir}/src</sourceDirectory>
            <testSourceDirectory>${project.basedir}/test</testSourceDirectory>
            <includeTests>true</includeTests>
            <printFailingErrors>true</printFailingErrors>
            <failOnViolation>true</failOnViolation>
            <linkXRef>false</linkXRef>
            <!-- L2: duplication detection -->
            <minimumTokens>100</minimumTokens>
            <excludeRoots>
                <excludeRoot>${project.basedir}/target</excludeRoot>
            </excludeRoots>
        </configuration>
        <executions>
            <execution>
                <id>pmd-check</id>
                <phase>verify</phase>
                <goals>
                    <goal>check</goal>
                </goals>
            </execution>
            <execution>
                <id>cpd-check</id>
                <phase>verify</phase>
                <goals>
                    <goal>cpd-check</goal>
                </goals>
            </execution>
        </executions>
    </plugin>
    <plugin>
        <!-- L1: magic numbers and cyclomatic complexity/method length (not covered by PMD/Spotless) -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
            <configLocation>${project.basedir}/checkstyle.xml</configLocation>
            <sourceDirectories>
                <sourceDirectory>${project.basedir}/src</sourceDirectory>
            </sourceDirectories>
            <includeTestSourceDirectory>false</includeTestSourceDirectory>
            <failOnViolation>true</failOnViolation>
              <!-- Both profiles use error: cool keeps structural checks at warning;
                  strict promotes only the agreed upper thresholds to error. -->
              <violationSeverity>error</violationSeverity>
            <linkXRef>false</linkXRef>
        </configuration>
        <executions>
            <execution>
                <id>checkstyle-check</id>
                <phase>verify</phase>
                <goals>
                    <goal>check</goal>
                </goals>
            </execution>
        </executions>
    </plugin>
    <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
            <execution>
                <id>jacoco-prepare-agent</id>
                <goals>
                    <goal>prepare-agent</goal>
                </goals>
            </execution>
            <execution>
                <id>jacoco-report</id>
                <phase>test</phase>
                <goals>
                    <goal>report</goal>
                </goals>
            </execution>
            <execution>
                <id>jacoco-check</id>
                <phase>verify</phase>
                <goals>
                    <goal>check</goal>
                </goals>
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <!-- COOL: 0.50, STRICT: 0.80 -->
                                    <minimum>0.50</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
            </execution>
        </executions>
    </plugin>
</plugins>
